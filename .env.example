LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL (default)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chinook
READONLY_DATABASE_URL=postgresql+psycopg2://readonly:readonly_pw@localhost:5432/chinook

# MySQL (optional alternative)
# DATABASE_URL=mysql+pymysql://admin:admin_pw@localhost:3306/chinook
# READONLY_DATABASE_URL=mysql+pymysql://readonly:readonly_pw@localhost:3306/chinook
